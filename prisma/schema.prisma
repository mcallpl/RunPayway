generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id                      String                   @id @default(cuid())
  name                    String
  created_at              DateTime                 @default(now())
  policies                Policy[]
  cohort_policy_bindings  CohortPolicyBinding[]
  evaluation_requests     EvaluationRequest[]
  evaluation_results      EvaluationResult[]
  audit_records           AuditRecord[]

  @@map("organizations")
}

model Policy {
  id              String                  @id @default(cuid())
  policy_id       String                  @unique
  policy_version  String
  policy_hash     String
  cohort_key      String
  rules           String                  @db.Text
  organization_id String
  created_at      DateTime                @default(now())
  updated_at      DateTime                @updatedAt
  organization    Organization            @relation(fields: [organization_id], references: [id])
  bindings        CohortPolicyBinding[]
  evaluation_requests EvaluationRequest[]

  @@unique([policy_id, policy_version])
  @@map("policies")
}

model CohortPolicyBinding {
  id              String   @id @default(cuid())
  organization_id String
  cohort_key      String
  policy_id       String
  active          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id])
  policy          Policy   @relation(fields: [policy_id], references: [id])

  @@unique([organization_id, cohort_key])
  @@map("cohort_policy_bindings")
}

model EvaluationRequest {
  id              String   @id @default(cuid())
  organization_id String
  cohort_key      String
  policy_id       String
  payload         String   @db.Text
  input_hash      String
  created_at      DateTime @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id])
  policy          Policy   @relation(fields: [policy_id], references: [id])
  result          EvaluationResult?
  audit_record    AuditRecord?

  @@map("evaluation_requests")
}

model EvaluationResult {
  id                        String   @id @default(cuid())
  evaluation_request_id     String   @unique
  organization_id           String
  status                    String
  compliance_classification String
  violation_score           Int
  reason_codes              String
  rule_results              String   @db.Text
  result_hash               String
  evaluator_version         String
  created_at                DateTime @default(now())
  organization              Organization @relation(fields: [organization_id], references: [id])
  evaluation_request        EvaluationRequest @relation(fields: [evaluation_request_id], references: [id])

  @@map("evaluation_results")
}

model AuditRecord {
  id                    String   @id @default(cuid())
  audit_id              String   @unique @default(cuid())
  evaluation_request_id String   @unique
  organization_id       String
  input_hash            String
  policy_hash           String
  result_hash           String
  evaluator_version     String
  replayable            Boolean  @default(true)
  created_at            DateTime @default(now())
  organization          Organization @relation(fields: [organization_id], references: [id])
  evaluation_request    EvaluationRequest @relation(fields: [evaluation_request_id], references: [id])

  @@map("audit_records")
}
