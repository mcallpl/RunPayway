generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id                      String                   @id @default(cuid())
  name                    String
  created_at              DateTime                 @default(now())
  policies                Policy[]
  cohort_policy_bindings  CohortPolicyBinding[]
  evaluation_requests     EvaluationRequest[]
  evaluation_results      EvaluationResult[]
  audit_records           AuditRecord[]

  @@map("organizations")
}

model Policy {
  id              String                  @id @default(cuid())
  policy_id       String                  @unique
  policy_version  String
  policy_hash     String
  cohort_key      String
  rules           String
  organization_id String
  created_at      DateTime                @default(now())
  updated_at      DateTime                @updatedAt
  organization    Organization            @relation(fields: [organization_id], references: [id])
  bindings        CohortPolicyBinding[]
  evaluation_requests EvaluationRequest[]

  @@unique([policy_id, policy_version])
  @@map("policies")
}

model CohortPolicyBinding {
  id              String   @id @default(cuid())
  organization_id String
  cohort_key      String
  policy_id       String
  active          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id])
  policy          Policy   @relation(fields: [policy_id], references: [id])

  @@unique([organization_id, cohort_key])
  @@map("cohort_policy_bindings")
}

model EvaluationRequest {
  id              String   @id @default(cuid())
  organization_id String
  cohort_key      String
  policy_id       String
  payload         String
  input_hash      String
  created_at      DateTime @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id])
  policy          Policy   @relation(fields: [policy_id], references: [id])
  result          EvaluationResult?
  audit_record    AuditRecord?

  @@map("evaluation_requests")
}

model EvaluationResult {
  id                        String   @id @default(cuid())
  evaluation_request_id     String   @unique
  organization_id           String
  status                    String
  compliance_classification String
  violation_score           Int
  reason_codes              String
  rule_results              String
  result_hash               String
  evaluator_version         String
  created_at                DateTime @default(now())
  organization              Organization @relation(fields: [organization_id], references: [id])
  evaluation_request        EvaluationRequest @relation(fields: [evaluation_request_id], references: [id])

  @@map("evaluation_results")
}

model AuditRecord {
  id                    String   @id @default(cuid())
  audit_id              String   @unique @default(cuid())
  evaluation_request_id String   @unique
  organization_id       String
  input_hash            String
  policy_hash           String
  result_hash           String
  evaluator_version     String
  replayable            Boolean  @default(true)
  created_at            DateTime @default(now())
  organization          Organization @relation(fields: [organization_id], references: [id])
  evaluation_request    EvaluationRequest @relation(fields: [evaluation_request_id], references: [id])

  @@map("audit_records")
}

model Evaluation {
  evaluation_id           String   @id @default(cuid())
  subject_id              String
  cohort_key              String
  policy_id               String
  policy_version          Int
  policy_hash             String
  evaluation_timestamp    DateTime
  payload_hash            String
  result_hash             String
  classification          String
  violation_score         Int      @default(0)
  triggered_reason_codes  String   @default("[]")
  created_at              DateTime @default(now())

  @@index([subject_id])
  @@index([cohort_key])
  @@index([evaluation_timestamp])
  @@index([created_at])
  @@index([result_hash])
  @@map("evaluations")
}

model PolicyVersion {
  policy_id         String
  version           Int
  source_definition String
  compiled_hash     String
  effective_date    DateTime?
  created_at        DateTime   @default(now())
  created_by        String?

  @@id([policy_id, version])
  @@index([created_at])
  @@map("policy_versions")
}

model AuditEvent {
  audit_id         String   @id @default(cuid())
  sequence_number  Int      @unique
  previous_hash    String?
  audit_hash       String   @unique

  event_type       String
  event_timestamp  DateTime
  created_at       DateTime @default(now())

  actor_id         String?
  subject_type     String
  subject_id       String

  evaluation_id    String?
  policy_id        String?
  policy_version   Int?

  details          String

  @@index([sequence_number])
  @@index([event_type])
  @@index([subject_type, subject_id])
  @@index([evaluation_id])
  @@index([policy_id, policy_version])
  @@index([actor_id])
  @@index([event_timestamp])
  @@index([created_at])
  @@index([audit_hash])

  @@map("audit_events")
}

