generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Evaluation {
  evaluation_id           String   @id @default(cuid())
  subject_id              String
  cohort_key              String
  policy_id               String
  policy_version          Int
  policy_hash             String
  evaluation_timestamp    DateTime
  payload_hash            String
  result_hash             String
  classification          String
  violation_score         Int      @default(0)
  triggered_reason_codes  String   @default("[]")
  created_at              DateTime @default(now())

  @@index([subject_id])
  @@index([cohort_key])
  @@index([evaluation_timestamp])
  @@index([created_at])
  @@index([result_hash])
  @@map("evaluations")
}

model PolicyVersion {
  policy_id         String
  version           Int
  source_definition String
  compiled_hash     String
  effective_date    DateTime?
  created_at        DateTime   @default(now())
  created_by        String?

  @@id([policy_id, version])
  @@index([created_at])
  @@map("policy_versions")
}

model AuditEvent {
  audit_id         String   @id @default(cuid())
  sequence_number  Int      @unique
  previous_hash    String?
  audit_hash       String   @unique

  event_type       String
  event_timestamp  DateTime
  created_at       DateTime @default(now())

  actor_id         String?
  subject_type     String
  subject_id       String

  evaluation_id    String?
  policy_id        String?
  policy_version   Int?

  details          String

  @@index([sequence_number])
  @@index([event_type])
  @@index([subject_type, subject_id])
  @@index([evaluation_id])
  @@index([policy_id, policy_version])
  @@index([actor_id])
  @@index([event_timestamp])
  @@index([created_at])
  @@index([audit_hash])

  @@map("audit_events")
}

// ============================================================================
// PHASE 6: GOVERNANCE LAYER
// Policy lifecycle management (draft → review → approved → active → retired/superseded)
// Separate from immutable PolicyVersion (Phase 5B)
// ============================================================================

model PolicyVersionGovernance {
  // Composite key: same as PolicyVersion
  policy_id         String
  version           Int

  // Governance state (String for SQLite compatibility)
  // Valid values: DRAFT, PENDING_REVIEW, APPROVED, ACTIVE, RETIRED, SUPERSEDED, REJECTED
  current_state     String                @default("DRAFT")
  previous_state    String?

  // Timestamps
  created_at        DateTime              @default(now())
  state_changed_at  DateTime              @default(now())
  last_actor_id     String?
  last_action       String?  // CREATED, SUBMITTED_FOR_REVIEW, APPROVED, REJECTED, ACTIVATED, RETIRED, SUPERSEDED

  // History tracking
  transition_count  Int                   @default(0)

  // Audit
  created_by        String?
  last_modified_by  String?

  // Unique constraint: one governance record per policy version
  @@id([policy_id, version])
  @@index([policy_id])
  @@index([current_state])
  @@index([state_changed_at])
  @@index([policy_id, current_state])

  @@map("policy_version_governance")
}

